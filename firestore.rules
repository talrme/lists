rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function googleAccount() {
      return request.auth != null && request.auth.token.email_verified == true
        && request.auth.token.firebase.sign_in_provider == 'google.com';
    }
    function administrator() {
      return googleAccount() && request.auth.token.email == 'talrme@gmail.com';
    }
    function household(space) {
      return get(/databases/$(database)/documents/listSpaces/$(space)).data;
    }
    function invited(data) {
      return request.auth.token.email in data.get('memberEmails', [])
        || (data.get('schemaVersion', 1) != 2 && request.auth.uid in data.get('memberUids', []));
    }
    function member(space) { return googleAccount() && invited(household(space)); }
    function readable(task) { return task.visibility == 'shared' || task.ownerUid == request.auth.uid; }
    function validHousehold(data, space) {
      return data.keys().hasAll(['schemaVersion','title','memberEmails','memberUids','names','createdBy','createdAt','updatedAt','rev'])
        && data.keys().hasOnly(['schemaVersion','title','memberEmails','memberUids','names','createdBy','createdAt','updatedAt','rev','kind','playgroundRun'])
        && ((!('kind' in data) && !('playgroundRun' in data))
          || (space == 'playground' && data.kind == 'playground' && data.playgroundRun is string
            && data.playgroundRun.matches('^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$')))
        && data.schemaVersion == 2 && data.title is string && data.title.size() > 0 && data.title.size() <= 80
        && data.memberEmails is list && data.memberEmails.size() > 0 && data.memberEmails.size() <= 20
        && data.memberEmails.toSet().size() == data.memberEmails.size()
        && data.memberUids is list && data.names is map && data.createdBy is string
        && data.createdAt is timestamp && data.updatedAt == request.time && data.rev is int;
    }
    function validAssignee(space, uid) {
      return uid == null
        || (household(space).get('schemaVersion', 1) != 2 && uid in household(space).get('memberUids', []))
        || get(/databases/$(database)/documents/listSpaces/$(space)/members/$(uid)).data.email in household(space).get('memberEmails', []);
    }
    function dateOrNull(value) {
      return value == null || (value is string && value.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'));
    }
    function validEmailAssignment(space, task) {
      return task.get('assigneeEmail', null) == null
        || (task.assigneeUid == null && task.visibility == 'shared'
          && task.assigneeEmail is string && task.assigneeEmail in household(space).get('memberEmails', []));
    }
    function validPhoto(data) {
      return data.get('photoURL', '') is string && data.get('photoURL', '').size() <= 2048
        && (data.get('photoURL', '') == '' || data.photoURL.matches('^https://([a-zA-Z0-9-]+[.])*googleusercontent[.]com/.*$'));
    }
    function validTask(task) {
      return task.keys().hasAll(['title','category','ownerUid','assigneeUid','visibility','dueDate','waiting','followUp','completed','rev','createdAt','updatedAt'])
        && task.keys().hasOnly(['title','description','sortOrder','someday','tagIds','category','ownerUid','assigneeUid','assigneeEmail','visibility','dueDate','waiting','followUp','completed','rev','createdAt','updatedAt'])
        && task.get('someday', false) is bool
        && (!task.get('someday', false) || (task.category == 'todo' && task.dueDate == null && !task.waiting && task.followUp == null))
        && task.get('tagIds', []) is list && task.get('tagIds', []).size() <= 20
        && task.get('tagIds', []).toSet().size() == task.get('tagIds', []).size()
        && validTagIds(task.get('tagIds', []))
        && task.get('sortOrder', 0) is number && task.get('sortOrder', 0) >= -1000000000000000 && task.get('sortOrder', 0) <= 1000000000000000
        && task.title is string && task.title.size() > 0 && task.title.size() <= 200
        && task.get('description', '') is string && task.get('description', '').size() <= 10000
        && task.category in ['todo','grocery','movies','other'] && task.ownerUid is string
        && (task.assigneeUid == null || task.assigneeUid is string)
        && (task.get('assigneeEmail', null) == null || task.assigneeEmail is string)
        && (task.get('assigneeEmail', null) == null || (task.assigneeUid == null && task.visibility == 'shared'))
        && task.visibility in ['private','shared']
        && (task.visibility == 'shared' || (task.ownerUid == request.auth.uid && task.assigneeUid == null))
        && dateOrNull(task.dueDate) && dateOrNull(task.followUp) && task.waiting is bool && task.completed is bool
        && (task.waiting ? task.dueDate == null : task.followUp == null)
        && task.rev is int && task.createdAt is number && task.updatedAt == request.time;
    }
    function tagId(ids, i) { return ids.size() <= i || (ids[i] is string && ids[i].matches('^[a-zA-Z0-9-]{1,80}$')); }
    function validTagIds(ids) { return tagId(ids, 0) && tagId(ids, 1) && tagId(ids, 2) && tagId(ids, 3) && tagId(ids, 4) && tagId(ids, 5) && tagId(ids, 6) && tagId(ids, 7) && tagId(ids, 8) && tagId(ids, 9) && tagId(ids, 10) && tagId(ids, 11) && tagId(ids, 12) && tagId(ids, 13) && tagId(ids, 14) && tagId(ids, 15) && tagId(ids, 16) && tagId(ids, 17) && tagId(ids, 18) && tagId(ids, 19); }
    match /listUsers/{uid} {
      match /preferences/{id} {
        allow read: if googleAccount() && (request.auth.uid == uid || administrator());
        allow create, update: if googleAccount() && request.auth.uid == uid && id == 'main'
          && request.resource.data.keys().hasOnly(['style','palette','showSomeday','audiences','updatedAt'])
          && request.resource.data.get('style', 1) in [1,7,4,8,9]
          && request.resource.data.get('palette', 'original') in ['original','garden','cherry','night']
          && request.resource.data.get('showSomeday', false) is bool
          && request.resource.data.get('audiences', {}) is map
          && request.resource.data.get('audiences', {}).keys().hasOnly(['todo','grocery','movies','other'])
          && request.resource.data.updatedAt == request.time;
        allow delete: if false;
      }
      allow read: if administrator() || (googleAccount() && request.auth.uid == uid);
      allow create, update: if googleAccount() && request.auth.uid == uid
        && request.resource.data.keys().hasAll(['email','name','updatedAt'])
        && request.resource.data.keys().hasOnly(['email','name','photoURL','updatedAt']) && validPhoto(request.resource.data)
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 80
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }
    match /listSpaces/{space} {
      allow get, list: if googleAccount() && (administrator() || invited(resource.data));
      allow create: if administrator() && space.matches('^[a-z0-9][a-z0-9-]{0,47}$')
        && validHousehold(request.resource.data, space) && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time && request.resource.data.rev == 1
        && request.resource.data.memberUids.size() == 0 && request.resource.data.names.size() == 0;
      allow update: if administrator() && validHousehold(request.resource.data, space)
        && request.resource.data.rev == resource.data.get('rev', 0) + 1
        && request.resource.data.memberUids == resource.data.get('memberUids', [])
        && request.resource.data.names == resource.data.get('names', {})
        && (resource.data.get('schemaVersion', 1) == 2
          ? (request.resource.data.createdBy == resource.data.createdBy && request.resource.data.createdAt == resource.data.createdAt)
          : (request.resource.data.createdBy == request.auth.uid && request.resource.data.createdAt == request.time));
      allow delete: if false;
      match /members/{uid} {
        allow read: if administrator() || member(space);
        allow create: if member(space) && uid == request.auth.uid
          && request.resource.data.keys().hasOnly(['email','name','photoURL','joinedAt']) && validPhoto(request.resource.data)
          && request.resource.data.email == request.auth.token.email
          && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 80
          && request.resource.data.joinedAt == request.time;
        allow update: if member(space) && uid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','photoURL']) && validPhoto(request.resource.data)
          && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 80;
        allow delete: if false;
      }
      match /environments/{environment}/tags/{tagId} {
        function validTag(data) {
          return data.keys().hasAll(['name','visibility','ownerUid','archived','mergedInto','updatedAt'])
            && data.keys().hasOnly(['name','visibility','ownerUid','archived','mergedInto','updatedAt'])
            && data.name is string && data.name.size() > 0 && data.name.size() <= 50
            && data.visibility in ['private','shared'] && data.ownerUid is string
            && data.archived is bool && (data.mergedInto == null || (data.mergedInto is string && data.mergedInto != tagId && data.mergedInto.matches('^[a-zA-Z0-9-]{1,80}$')))
            && data.updatedAt == request.time;
        }
        function validMerge(data) {
          let target = get(/databases/$(database)/documents/listSpaces/$(space)/environments/$(environment)/tags/$(data.mergedInto)).data;
          return target.mergedInto == null && !target.archived && target.visibility == data.visibility
            && (data.visibility == 'shared' || target.ownerUid == request.auth.uid);
        }
        allow read: if administrator() || (member(space) && readable(resource.data));
        allow create: if member(space) && tagId.matches('^[a-zA-Z0-9-]{1,80}$') && validTag(request.resource.data)
          && request.resource.data.ownerUid == request.auth.uid && request.resource.data.mergedInto == null;
        allow update: if member(space) && readable(resource.data) && validTag(request.resource.data)
          && request.resource.data.ownerUid == resource.data.ownerUid && request.resource.data.visibility == resource.data.visibility
          && (request.resource.data.mergedInto == resource.data.mergedInto
            || (resource.data.mergedInto == null && request.resource.data.archived && validMerge(request.resource.data)));
        allow delete: if false;
      }
      match /environments/{environment}/tasks/{taskId} {
        allow get: if administrator() || (member(space) && (!exists(/databases/$(database)/documents/listSpaces/$(space)/environments/$(environment)/tasks/$(taskId)) || readable(resource.data)));
        allow list: if administrator() || (member(space) && readable(resource.data));
        allow create: if member(space) && validTask(request.resource.data) && validAssignee(space,request.resource.data.assigneeUid) && validEmailAssignment(space,request.resource.data)
          && request.resource.data.ownerUid == request.auth.uid && request.resource.data.rev == 1;
        allow update: if member(space) && readable(resource.data) && validTask(request.resource.data)
          && (request.resource.data.get('assigneeEmail', null) == resource.data.get('assigneeEmail', null) || validEmailAssignment(space,request.resource.data))
          && (request.resource.data.assigneeUid == resource.data.assigneeUid || validAssignee(space,request.resource.data.assigneeUid))
          && request.resource.data.ownerUid == resource.data.ownerUid
          && request.resource.data.createdAt == resource.data.createdAt && request.resource.data.rev == resource.data.rev + 1;
        allow delete: if member(space) && readable(resource.data);
      }
      function validGroceryEnvelope(data) {
        return data.keys().hasAll(['type','key','value','rev','updatedAt'])
          && data.keys().hasOnly(['type','key','value','rev','updatedAt'])
          && data.key is string && data.key.size() > 0 && data.key.size() <= 160
          && data.value is map && data.rev is int && data.rev > 0 && data.updatedAt == request.time;
      }
      function groceryName(value) { return value.name is string && value.name.size() > 0 && value.name.size() <= 120; }
      function groceryQuantity(value) {
        return groceryName(value) && value.category is string && value.category.size() <= 60
          && value.quantity is number && value.quantity > 0 && value.quantity <= 9999
          && value.unit is string && value.unit.size() > 0 && value.unit.size() <= 20
          && value.get('notes', '') is string && value.get('notes', '').size() <= 2000
          && value.get('locations', {}) is map && value.get('locations', {}).size() <= 40;
      }
      function validGrocery(data) {
        let value = data.value;
        return validGroceryEnvelope(data) && (
          (data.type == 'item' && groceryQuantity(value) && value.active is bool
            && value.catalogId is string && value.catalogId.size() <= 160
            && value.keys().hasOnly(['name','category','quantity','unit','notes','catalogId','locations','active']))
          || (data.type == 'catalog' && groceryQuantity(value) && value.archived is bool
            && value.aliases is list && value.aliases.size() <= 30 && value.source is string && value.source.size() <= 30
            && value.keys().hasOnly(['name','category','quantity','unit','notes','locations','aliases','archived','source']))
          || (data.type == 'list' && groceryName(value) && value.entries is list && value.entries.size() <= 150 && value.archived is bool
            && value.keys().hasOnly(['name','entries','archived']))
          || (data.type == 'store' && groceryName(value) && value.locations is list && value.locations.size() <= 60 && value.archived is bool
            && value.keys().hasOnly(['name','locations','archived'])));
      }
      match /environments/{environment}/groceries/{id} {
        allow read: if administrator() || member(space);
        allow create: if member(space) && id.matches('^(item|catalog|list|store)--[a-zA-Z0-9-]{1,160}$')
          && id == request.resource.data.type + '--' + request.resource.data.key
          && validGrocery(request.resource.data) && request.resource.data.rev == 1;
        allow update: if member(space) && validGrocery(request.resource.data)
          && request.resource.data.type == resource.data.type && request.resource.data.key == resource.data.key
          && request.resource.data.rev == resource.data.rev + 1;
        allow delete: if false;
      }
      match /environments/{environment}/groceryPurchases/{id} {
        function validPurchase(data) {
          let value = data.value;
          return validGroceryEnvelope(data) && data.type == 'purchase' && data.key == id && groceryQuantity(value)
            && value.catalogId is string && value.itemId is string && value.itemRev is int
            && value.at is number && value.day is string && value.day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
            && value.storeId is string && value.storeId.size() <= 100 && value.undone is bool
            && value.keys().hasOnly(['name','category','quantity','unit','notes','catalogId','locations','active','at','day','storeId','undone','itemId','itemRev']);
        }
        allow read: if administrator() || member(space);
        allow create: if member(space) && validPurchase(request.resource.data) && request.resource.data.rev == 1 && !request.resource.data.value.undone;
        allow update: if member(space) && validPurchase(request.resource.data)
          && request.resource.data.rev == resource.data.rev + 1
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rev','updatedAt','value'])
          && request.resource.data.value.diff(resource.data.value).affectedKeys().hasOnly(['undone'])
          && request.resource.data.value.undone && !resource.data.value.undone;
        allow delete: if false;
      }
      match /environments/{environment}/groceryCommands/{id} {
        allow read: if administrator() || member(space);
        allow create: if member(space) && request.resource.data.keys().hasOnly(['actor','createdAt'])
          && request.resource.data.actor == request.auth.uid && request.resource.data.createdAt == request.time;
        allow update, delete: if false;
      }
      match /environments/{environment}/daily/{day}/picks/{uid} {
        function eligible(taskId) {
          let task = get(/databases/$(database)/documents/listSpaces/$(space)/environments/$(environment)/tasks/$(taskId)).data;
          return task.category == 'todo' && !task.get('someday', false) && !task.completed && !task.waiting && (task.dueDate == null || task.dueDate > day)
            && ((task.visibility == 'private' && task.ownerUid == request.auth.uid)
              || (task.visibility == 'shared' && ((task.assigneeUid == null && task.get('assigneeEmail', null) == null)
                || task.assigneeUid == request.auth.uid || task.get('assigneeEmail', null) == request.auth.token.email)));
        }
        allow read: if administrator() || (member(space) && uid == request.auth.uid);
        allow create: if member(space) && uid == request.auth.uid && day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && request.resource.data.keys().hasOnly(['taskId','createdAt']) && request.resource.data.createdAt == request.time
          && (request.resource.data.taskId == null || (request.resource.data.taskId is string && eligible(request.resource.data.taskId)));
        allow update: if member(space) && uid == request.auth.uid && resource.data.taskId == null
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['taskId'])
          && request.resource.data.taskId is string && eligible(request.resource.data.taskId);
        allow delete: if false;
      }
    }
    match /{document=**} { allow read, write: if false; }
  }
}

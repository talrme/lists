rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function approvedAccount() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.firebase.sign_in_provider == 'google.com'
        && request.auth.token.email in ['talrme@gmail.com', 'sophiegreen2@gmail.com'];
    }
    function household(space) {
      return get(/databases/$(database)/documents/listSpaces/$(space)).data;
    }
    function member(space) {
      return approvedAccount() && request.auth.uid in household(space).memberUids;
    }
    function readable(task) {
      return task.visibility == 'shared' || task.ownerUid == request.auth.uid;
    }
    function dateOrNull(value) {
      return value == null || (value is string && value.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'));
    }
    function validTask(space, task) {
      return task.keys().hasAll(['title','category','ownerUid','assigneeUid','visibility','dueDate','waiting','followUp','completed','rev','createdAt','updatedAt'])
        && task.keys().hasOnly(['title','category','ownerUid','assigneeUid','visibility','dueDate','waiting','followUp','completed','rev','createdAt','updatedAt'])
        && task.title is string && task.title.size() > 0 && task.title.size() <= 200
        && task.category in ['todo','grocery','movies','other']
        && task.ownerUid in household(space).memberUids
        && (task.assigneeUid == null || task.assigneeUid in household(space).memberUids)
        && task.visibility in ['private','shared']
        && (task.visibility == 'shared' || (task.ownerUid == request.auth.uid && task.assigneeUid == null))
        && dateOrNull(task.dueDate) && dateOrNull(task.followUp)
        && task.waiting is bool && task.completed is bool
        && (task.waiting ? (task.followUp != null && task.dueDate == null) : task.followUp == null)
        && task.rev is int && task.createdAt is number
        && task.updatedAt == request.time;
    }
    match /listSpaces/{space} {
      allow read: if approvedAccount() && request.auth.uid in resource.data.memberUids;
      allow write: if false;
      match /environments/{environment}/tasks/{taskId} {
        allow get: if member(space) && (!exists(/databases/$(database)/documents/listSpaces/$(space)/environments/$(environment)/tasks/$(taskId)) || readable(resource.data));
        allow list: if member(space) && readable(resource.data);
        allow create: if member(space) && validTask(space,request.resource.data)
          && request.resource.data.ownerUid == request.auth.uid && request.resource.data.rev == 1;
        allow update: if member(space) && readable(resource.data) && validTask(space,request.resource.data)
          && request.resource.data.ownerUid == resource.data.ownerUid
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.rev == resource.data.rev + 1;
        allow delete: if member(space) && readable(resource.data);
      }
      match /environments/{environment}/daily/{day}/picks/{uid} {
        function eligible(taskId) {
          let task = get(/databases/$(database)/documents/listSpaces/$(space)/environments/$(environment)/tasks/$(taskId)).data;
          return task.category == 'todo' && !task.completed && !task.waiting && task.dueDate == null
            && ((task.visibility == 'private' && task.ownerUid == request.auth.uid)
              || (task.visibility == 'shared' && (task.assigneeUid == null || task.assigneeUid == request.auth.uid)));
        }
        allow read: if member(space) && uid == request.auth.uid;
        allow create: if member(space) && uid == request.auth.uid
          && day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && request.resource.data.keys().hasOnly(['taskId','createdAt'])
          && request.resource.data.createdAt == request.time
          && (request.resource.data.taskId == null || (request.resource.data.taskId is string && eligible(request.resource.data.taskId)));
        allow update, delete: if false;
      }
    }
    match /{document=**} { allow read, write: if false; }
  }
}

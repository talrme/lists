rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function googleAccount() {
      return request.auth != null && request.auth.token.email_verified == true
        && request.auth.token.firebase.sign_in_provider == 'google.com';
    }
    function administrator() {
      return googleAccount() && request.auth.token.email == 'talrme@gmail.com';
    }
    function household(space) {
      return get(/databases/$(database)/documents/listSpaces/$(space)).data;
    }
    function invited(data) {
      return request.auth.token.email in data.get('memberEmails', [])
        || (data.get('schemaVersion', 1) != 2 && request.auth.uid in data.get('memberUids', []));
    }
    function member(space) { return googleAccount() && invited(household(space)); }
    function readable(task) { return task.visibility == 'shared' || task.ownerUid == request.auth.uid; }
    function validHousehold(data) {
      return data.keys().hasAll(['schemaVersion','title','memberEmails','memberUids','names','createdBy','createdAt','updatedAt','rev'])
        && data.keys().hasOnly(['schemaVersion','title','memberEmails','memberUids','names','createdBy','createdAt','updatedAt','rev'])
        && data.schemaVersion == 2 && data.title is string && data.title.size() > 0 && data.title.size() <= 80
        && data.memberEmails is list && data.memberEmails.size() > 0 && data.memberEmails.size() <= 20
        && data.memberEmails.toSet().size() == data.memberEmails.size()
        && data.memberUids is list && data.names is map && data.createdBy is string
        && data.createdAt is timestamp && data.updatedAt == request.time && data.rev is int;
    }
    function validAssignee(space, uid) {
      return uid == null
        || (household(space).get('schemaVersion', 1) != 2 && uid in household(space).get('memberUids', []))
        || get(/databases/$(database)/documents/listSpaces/$(space)/members/$(uid)).data.email in household(space).get('memberEmails', []);
    }
    function dateOrNull(value) {
      return value == null || (value is string && value.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'));
    }
    function validPhoto(data) {
      return data.get('photoURL', '') is string && data.get('photoURL', '').size() <= 2048
        && (data.get('photoURL', '') == '' || data.photoURL.matches('^https://([a-zA-Z0-9-]+[.])*googleusercontent[.]com/.*$'));
    }
    function validTask(task) {
      return task.keys().hasAll(['title','category','ownerUid','assigneeUid','visibility','dueDate','waiting','followUp','completed','rev','createdAt','updatedAt'])
        && task.keys().hasOnly(['title','description','sortOrder','category','ownerUid','assigneeUid','visibility','dueDate','waiting','followUp','completed','rev','createdAt','updatedAt'])
        && task.get('sortOrder', 0) is number && task.get('sortOrder', 0) >= -1000000000000000 && task.get('sortOrder', 0) <= 1000000000000000
        && task.title is string && task.title.size() > 0 && task.title.size() <= 200
        && task.get('description', '') is string && task.get('description', '').size() <= 10000
        && task.category in ['todo','grocery','movies','other'] && task.ownerUid is string
        && (task.assigneeUid == null || task.assigneeUid is string)
        && task.visibility in ['private','shared']
        && (task.visibility == 'shared' || (task.ownerUid == request.auth.uid && task.assigneeUid == null))
        && dateOrNull(task.dueDate) && dateOrNull(task.followUp) && task.waiting is bool && task.completed is bool
        && (task.waiting ? (task.followUp != null && task.dueDate == null) : task.followUp == null)
        && task.rev is int && task.createdAt is number && task.updatedAt == request.time;
    }
    match /listUsers/{uid} {
      allow read: if administrator() || (googleAccount() && request.auth.uid == uid);
      allow create, update: if googleAccount() && request.auth.uid == uid
        && request.resource.data.keys().hasAll(['email','name','updatedAt'])
        && request.resource.data.keys().hasOnly(['email','name','photoURL','updatedAt']) && validPhoto(request.resource.data)
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 80
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }
    match /listSpaces/{space} {
      allow get, list: if googleAccount() && (administrator() || invited(resource.data));
      allow create: if administrator() && space.matches('^[a-z0-9][a-z0-9-]{0,47}$')
        && validHousehold(request.resource.data) && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time && request.resource.data.rev == 1
        && request.resource.data.memberUids.size() == 0 && request.resource.data.names.size() == 0;
      allow update: if administrator() && validHousehold(request.resource.data)
        && request.resource.data.rev == resource.data.get('rev', 0) + 1
        && request.resource.data.memberUids == resource.data.get('memberUids', [])
        && request.resource.data.names == resource.data.get('names', {})
        && (resource.data.get('schemaVersion', 1) == 2
          ? (request.resource.data.createdBy == resource.data.createdBy && request.resource.data.createdAt == resource.data.createdAt)
          : (request.resource.data.createdBy == request.auth.uid && request.resource.data.createdAt == request.time));
      allow delete: if false;
      match /members/{uid} {
        allow read: if administrator() || member(space);
        allow create: if member(space) && uid == request.auth.uid
          && request.resource.data.keys().hasOnly(['email','name','photoURL','joinedAt']) && validPhoto(request.resource.data)
          && request.resource.data.email == request.auth.token.email
          && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 80
          && request.resource.data.joinedAt == request.time;
        allow update: if member(space) && uid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','photoURL']) && validPhoto(request.resource.data)
          && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 80;
        allow delete: if false;
      }
      match /environments/{environment}/tasks/{taskId} {
        allow get: if administrator() || (member(space) && (!exists(/databases/$(database)/documents/listSpaces/$(space)/environments/$(environment)/tasks/$(taskId)) || readable(resource.data)));
        allow list: if administrator() || (member(space) && readable(resource.data));
        allow create: if member(space) && validTask(request.resource.data) && validAssignee(space,request.resource.data.assigneeUid)
          && request.resource.data.ownerUid == request.auth.uid && request.resource.data.rev == 1;
        allow update: if member(space) && readable(resource.data) && validTask(request.resource.data)
          && (request.resource.data.assigneeUid == resource.data.assigneeUid || validAssignee(space,request.resource.data.assigneeUid))
          && request.resource.data.ownerUid == resource.data.ownerUid
          && request.resource.data.createdAt == resource.data.createdAt && request.resource.data.rev == resource.data.rev + 1;
        allow delete: if member(space) && readable(resource.data);
      }
      match /environments/{environment}/daily/{day}/picks/{uid} {
        function eligible(taskId) {
          let task = get(/databases/$(database)/documents/listSpaces/$(space)/environments/$(environment)/tasks/$(taskId)).data;
          return task.category == 'todo' && !task.completed && !task.waiting && task.dueDate == null
            && ((task.visibility == 'private' && task.ownerUid == request.auth.uid)
              || (task.visibility == 'shared' && (task.assigneeUid == null || task.assigneeUid == request.auth.uid)));
        }
        allow read: if administrator() || (member(space) && uid == request.auth.uid);
        allow create: if member(space) && uid == request.auth.uid && day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && request.resource.data.keys().hasOnly(['taskId','createdAt']) && request.resource.data.createdAt == request.time
          && (request.resource.data.taskId == null || (request.resource.data.taskId is string && eligible(request.resource.data.taskId)));
        allow update, delete: if false;
      }
    }
    match /{document=**} { allow read, write: if false; }
  }
}
